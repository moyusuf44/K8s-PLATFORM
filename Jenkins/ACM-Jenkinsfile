pipeline {
    agent any

    environment {
        AWS_REGION  = 'eu-north-1'
        DOMAIN_NAME = 'moyusufs-k8s-app.com'
        SUBDOMAIN   = 'tm'
    }

    stages {
        stage('ACM') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    dir('Infra/modules/05-acm') {
                        bat 'terraform init'
                        bat 'terraform apply --auto-approve -var="domain_name=%DOMAIN_NAME%" -var="subdomain=%SUBDOMAIN%"'
                    }
                }
            }
        }
    }
}
