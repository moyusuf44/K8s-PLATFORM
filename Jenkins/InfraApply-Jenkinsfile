pipeline {
    agent any 
    
     environment {
        AWS_REGION = 'eu-north-1'
    }

    stages{
        stage ('terraform apply'){
            steps {
                withCredentials([[
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-credentials'
                ]]) {
                dir ('Infra'){
                 withCredentials([string(credentialsId: 'CLOUDFLARE_API_TOKEN', variable: 'TF_VAR_cloudflare_api_token')]) {
                bat 'terraform init'
                bat 'terraform apply --auto-approve'
                        }
                    }    
                }
            }
        }
   }
}




