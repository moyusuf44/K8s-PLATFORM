pipeline {
    agent any 
    
     environment {
        AWS_REGION = 'eu-north-1'
    }

    stages{      
        stage('Docker'){
            steps {
                withCredentials([[
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-credentials'
                ]]) {
                bat 'docker build -t k8s-app:v1 .'
                bat 'docker tag k8s-app:v1 592587463331.dkr.ecr.eu-north-1.amazonaws.com/k8s-app:v1'
                bat 'aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin 592587463331.dkr.ecr.eu-north-1.amazonaws.com'           
                bat 'docker push 592587463331.dkr.ecr.eu-north-1.amazonaws.com/k8s-app:v1'
                }   
            }
        } 
    }
}




