pipeline {
    agent any 
    
     environment {
        AWS_REGION = 'eu-north-1'
    }

    stages{
        stage('Repo'){
            steps {
                withCredentials([[
                $class: 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-credentials'
                ]]) {
                dir('Infra/modules/02-ecr'){
                bat 'terraform init'
                bat 'terraform apply --auto-approve'
                    }
                }
            }
        } 
    }
}